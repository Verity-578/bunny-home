# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Access password (empty disables the gate)
APP_PASSWORD=

# Local persistence (used until Supabase credentials are added)
DATABASE_PATH=./data/bunny-home.db

# Supabase (add after project creation)
SUPABASE_URL=
SUPABASE_KEY=

# Main model (set variable name after confirming your relay/provider)
MAIN_MODEL_API_KEY=
MAIN_MODEL_BASE_URL=
MAIN_MODEL_NAME=

# Compression model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat
